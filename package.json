{
	"name": "newlife",
	"type": "module",
	"version": "1.0.1",
	"description": "My project for Software Development Cource",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/hvidom/newlife.git"
	},
	"keywords": [],
	"author": "hvidom",
	"license": "MIT",
	"bugs": {
		"url": "https://github.com/hvidom/newlife/issues"
	},
	"homepage": "https://github.com/hvidom/newlife#readme",
	"engines": {
		"node": ">=22.12.0"
	},
	"scripts": {
		"start": "bun run generate-types && bun run astro dev --verbose",
		"dev": "astro dev",
		"browserslist": "bunx update-browserslist-db@latest",
		"build": "bun run generate-types && bun run sync && bun run astro build && bun run build:tailwind && bun run build:postcss",
		"sync": "astro sync",
		"build:tailwind": "bun x @tailwindcss/cli -i src/styles/global.css -o dist/global.css --minify",
		"build:postcss": "postcss dist/global.css -o dist/global.css",
		"generate-types": "wrangler types",
		"format": "bunx --bun @biomejs/biome format --write",
		"lint": "bunx --bun @biomejs/biome lint --write",
		"check": "bunx --bun @biomejs/biome check src --write"
	},
	"dependencies": {
		"@astrojs/cloudflare": "^13.5.4",
		"@astrojs/mdx": "^5.0.6",
		"@astrojs/react": "^5.0.5",
		"@astrojs/sitemap": "^3.7.2",
		"@fontsource-variable/inter": "^5.2.8",
		"@tailwindcss/cli": "^4.3.0",
		"@tailwindcss/postcss": "^4.3.0",
		"@tailwindcss/vite": "^4.3.0",
		"@types/react": "^19.2.15",
		"@types/react-dom": "^19.2.3",
		"astro": "^6.3.7",
		"baseline-browser-mapping": "^2.10.32",
		"caniuse-lite": "^1.0.30001793",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"hono": "^4.12.23",
		"lucide-react": "^1.16.0",
		"radix-ui": "^1.4.3",
		"react": "^19.2.6",
		"react-dom": "^19.2.6",
		"shadcn": "^4.8.0",
		"tailwind-merge": "^3.6.0",
		"tailwindcss": "^4.3.0",
		"tw-animate-css": "^1.4.0",
		"wrangler": "^4.94.0"
	},
	"private": true,
	"devDependencies": {
		"@biomejs/biome": "2.4.15",
		"@types/bun": "latest",
		"postcss": "^8.5.15",
		"postcss-cli": "^11.0.1"
	},
	"peerDependencies": {
		"typescript": "^5"
	},
	"overrides": {
		"vite": "^7"
	}
}
