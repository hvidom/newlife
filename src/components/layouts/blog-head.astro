---
import { siteConfig } from "@/config/site";
import "@/styles/global.css";
import "@/styles/scrollbar.css";
import { ClientRouter } from "astro:transitions";

interface Props {
  title: string;
  description?: string;
  image?: string;
  type?: "website" | "article"; // Добавили тип: article для блогов, website для обычных страниц
  publishDate?: string; // Для вывода даты публикации статьи в блоге
  author?: string; // Для указания автора статьи
}

const {
  title,
  description,
  image,
  type = "article",
  publishDate,
  author = "Newlife Team",
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, siteConfig.url);

const seoDescription = description
  ? description.length > 155
    ? `${description.substring(0, 152)}...`
    : description
  : siteConfig.description;

const seoTitle = title ? `${title} | Newlife` : "Newlife Integration & Wellbeing";

const ogImageUrl = image
  ? new URL(image, siteConfig.url)
  : new URL("/fallback.png", siteConfig.url);
---


<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<link rel="icon" type="image/svg+xml" href="/favicon.svg">
<link rel="icon" href="/favicon.ico">
<meta name="generator" content={Astro.generator}>


<meta name="geo.region" content="IE" />
<meta name="geo.placename" content="Dublin" />
<meta property="og:locale" content="en_IE" />


<title>{seoTitle}</title>
<meta name="title" content={seoTitle}>
<meta name="description" content={seoDescription}>
<link rel="canonical" href={canonicalURL}>


<meta property="og:type" content={type}>
<meta property="og:url" content={canonicalURL}>
<meta property="og:title" content={seoTitle}>
<meta property="og:description" content={seoDescription}>
<meta property="og:image" content={ogImageUrl}>


{type === "article" && (
  <>
    {publishDate && <meta property="article:published_time" content={publishDate} />}
    <meta property="article:author" content={author} />
  </>
)}


<meta property="twitter:card" content="summary_large_image">
<meta property="twitter:url" content={canonicalURL}>
<meta property="twitter:title" content={seoTitle}>
<meta property="twitter:description" content={seoDescription}>
<meta property="twitter:image" content={ogImageUrl}>

<link rel="preconnect" href="https://api.brevo.com" crossorigin />


<ClientRouter />


<script type="application/ld+json" is:inline define:vars={{ type, seoTitle, seoDescription, ogImageUrl, canonicalURL, publishDate, author }}>
  const baseSchema = {
    "@context": "https://schema.org",
    "@type": "NGO",
    "name": "New Life Integration & Wellbeing Network CLG",
    "url": "https://newlifeintegration.ie",
    "logo": "https://newlifeintegration.ie/favicon.svg",
    "address": {
      "@type": "PostalAddress",
      "addressCountry": "IE",
      "addressLocality": "Dublin"
    }
  };

  // Если это страница блога, добавляем схему статьи (Google выведет её в топ-карусель)
  if (type === "article") {
    const articleSchema = {
      "@context": "https://schema.org",
      "@type": "BlogPosting",
      "headline": seoTitle,
      "description": seoDescription,
      "image": ogImageUrl,
      "datePublished": publishDate || new Date().toISOString(),
      "author": {
        "@type": "Person",
        "name": author
      },
      "publisher": baseSchema,
      "mainEntityOfPage": canonicalURL
    };
    document.write(`<script type="application/ld+json">${JSON.stringify(articleSchema)}<\/script>`);
  } else {
    document.write(`<script type="application/ld+json">${JSON.stringify(baseSchema)}<\/script>`);
  }
</script>

<script is:inline>
  // Принудительная светлая тема
  document.documentElement.classList.remove("dark");
  if (typeof localStorage !== "undefined") {
    localStorage.setItem("theme", "light");
  }
</script>