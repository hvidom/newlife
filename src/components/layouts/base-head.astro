---
import { siteConfig } from "@/config/site";
import "@/styles/global.css";
import "@/styles/scrollbar.css";
import { ClientRouter } from "astro:transitions";

interface Props {
  title: string;
  description?: string;
  image?: string;
}

const { title, description, image } = Astro.props;


const canonicalURL = new URL(Astro.url.pathname, siteConfig.url);


const seoDescription = description
  ? description.length > 155
    ? `${description.substring(0, 152)}...`
    : description
  : siteConfig.description;

const seoTitle = title ? `${title} | Newlife` : "Newlife Integration & Wellbeing";
const keywords =
  "New Life Integration, Wellbeing Network Ireland, community integration CLG, social inclusion Dublin, migrant support Ireland, creative programs wellbeing, community safety, personal development Ireland";

const ogImageUrl = image
  ? new URL(image, siteConfig.url)
  : new URL("/fallback.png", siteConfig.url);
---

<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<link rel="icon" type="image/svg+xml" href="/favicon.svg">
<link rel="icon" href="/favicon.ico">
<meta name="generator" content={Astro.generator}>

<meta name="geo.region" content="IE" />
<meta name="geo.placename" content="Dublin" />
<meta property="og:locale" content="en_IE" />

<title>{seoTitle}</title>
<meta name="title" content={seoTitle}>
<meta name="description" content={seoDescription}>
<link rel="canonical" href={canonicalURL}>
<meta name="keywords" content={keywords} />

<meta property="og:type" content="website">
<meta property="og:url" content={canonicalURL}>
<meta property="og:title" content={seoTitle}>
<meta property="og:description" content={seoDescription}>
<meta property="og:image" content={ogImageUrl}>

<meta property="twitter:card" content="summary_large_image">
<meta property="twitter:url" content={canonicalURL}>
<meta property="twitter:title" content={seoTitle}>
<meta property="twitter:description" content={seoDescription}>
<meta property="twitter:image" content={ogImageUrl}>

<link rel="preconnect" href="https://api.brevo.com" crossorigin />

<ClientRouter />

<link rel="preload" href="/fonts/Inter-Bold.woff2" as="font" type="font/woff2" crossorigin />

<script type="application/ld+json" is:inline define:vars={{ seoTitle, seoDescription, ogImageUrl, canonicalURL }}>
  {
    "@context": "https://schema.org",
    "@type": "NGO",
    "name": "New Life Integration & Wellbeing Network CLG",
    "url": "https://newlifeintegration.ie",
    "logo": "https://newlifeintegration.ie/favicon.svg",
    "image": ogImageUrl,
    "description": "Supporting Integration and Personal Wellbeing in Ireland.",
    "address": {
      "@type": "PostalAddress",
      "addressCountry": "IE",
      "addressLocality": "Dublin"
    },
    "contactPoint": {
      "@type": "ContactPoint",
      "contactType": "customer service",
      "email": "info@newlifeintegration.ie",
      "availableLanguage": "en"
    }
  }
</script>

<script is:inline>
  const getTheme = () => {
    if (typeof localStorage !== 'undefined' && localStorage.getItem('theme')) {
      return localStorage.getItem('theme');
    }
    return 'light';
  };
  const setClass = () => {
    const isDark = getTheme() === 'dark';
    document.documentElement.classList[isDark ? 'add' : 'remove']('dark');
  };

  setClass();
  document.addEventListener('astro:after-swap', setClass);
</script>