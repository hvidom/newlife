<script is:inline>
  window.dataLayer = window.dataLayer || [];
  function gtag(){window.dataLayer.push(arguments);}

  gtag('consent', 'default', {
    'ad_storage': 'denied',
    'ad_user_data': 'denied',
    'ad_sign_in': 'denied',
    'ad_personalization': 'denied',
    'analytics_storage': 'denied',
    'wait_for_update': 500
  });
</script>

<script is:inline>
  (function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
  new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s),
  j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
  'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
  })(window,document,'script','dataLayer','GTM-K2T4GFL8');
</script>

<noscript>
  <iframe src="https://www.googletagmanager.com/ns.html?id=GTM-K2T4GFL8"
  height="0" width="0" style="display:none;visibility:hidden"></iframe>
</noscript>


<div 
  id="cookie-banner" 
  data-astro-transition-persist="cookie-banner"
  class="fixed bottom-4 left-4 right-4 md:left-auto md:max-w-md bg-background/95 backdrop-blur-md border border-border/80 p-5 rounded-xl shadow-2xl flex flex-col gap-4 transition-all duration-300 opacity-0 pointer-events-none translate-y-4 z- isolate"
>
  <div class="flex flex-col gap-1">
    <h3 class="text-base font-bold text-foreground flex items-center gap-2">
      🍪 Cookie Preferences
    </h3>
    <p class="text-xs sm:text-sm text-muted-foreground leading-relaxed">
      We use cookies to optimize performance, protect our site via Cloudflare, and analyze traffic using Google Analytics. Read our 
      <a href="/privacy-policy" class="text-primary hover:underline font-medium">Privacy Policy</a>.
    </p>
  </div>
  
  <div class="flex items-center justify-end gap-2 text-xs sm:text-sm">
    <button 
      id="cookie-reject-btn" 
      class="px-4 py-2 font-medium text-muted-foreground bg-secondary/50 hover:bg-secondary border border-border/60 rounded-lg transition-colors cursor-pointer"
    >
      Reject All
    </button>
    <button 
      id="cookie-accept-btn" 
      class="px-4 py-2 font-medium text-primary-foreground bg-primary hover:bg-primary/90 rounded-lg shadow-sm shadow-primary/20 transition-colors cursor-pointer"
    >
      Accept All
    </button>
  </div>
</div>


<script>
  function applyGtmConsent(status: 'granted' | 'denied') {
    // @ts-ignore
    if (typeof window !== 'undefined' && window.gtag) {
      // @ts-ignore
      window.gtag('consent', 'update', {
        'ad_storage': status,
        'ad_user_data': status,
        'ad_sign_in': status,
        'ad_personalization': status,
        'analytics_storage': status
      });
    }
  }

  function initCookieBanner() {
    const banner = document.getElementById('cookie-banner');
    const acceptBtn = document.getElementById('cookie-accept-btn');
    const rejectBtn = document.getElementById('cookie-reject-btn');
    
    if (!banner || !acceptBtn || !rejectBtn) return;

    const savedConsent = localStorage.getItem('cookie-consent');

    if (savedConsent === 'granted') {
      applyGtmConsent('granted');
      return; 
    } else if (savedConsent === 'denied') {
      applyGtmConsent('denied');
      return; 
    }

    banner.classList.remove('opacity-0', 'pointer-events-none', 'translate-y-4');
    banner.classList.add('opacity-100', 'pointer-events-auto', 'translate-y-0');

    acceptBtn.onclick = () => {
      localStorage.setItem('cookie-consent', 'granted');
      applyGtmConsent('granted');
      hideBanner(banner);
    };

    rejectBtn.onclick = () => {
      localStorage.setItem('cookie-consent', 'denied');
      applyGtmConsent('denied');
      hideBanner(banner);
    };
  }

  function hideBanner(banner: HTMLElement) {
    banner.classList.remove('opacity-100', 'pointer-events-auto', 'translate-y-0');
    banner.classList.add('opacity-0', 'pointer-events-none', 'translate-y-4');
  }

  document.addEventListener('astro:page-load', initCookieBanner);
</script>