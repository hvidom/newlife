---
// Astro Theme Toggle с круговой анимацией раскрытия экрана (как в MagicUI)
---

<button
  id="astro-theme-toggle"
  class="group relative h-9 w-9 flex items-center justify-center rounded-lg border border-border/40 text-muted-foreground hover:text-primary hover:bg-muted transition-all duration-300 active:scale-90"
  aria-label="Toggle theme"
>
  <div class="relative h-4 w-4 flex items-center justify-center overflow-hidden">
    <svg 
      class="absolute h-4 w-4 transition-all duration-500 ease-out transform
             dark:rotate-90 dark:scale-0 dark:opacity-0
             rotate-0 scale-100 opacity-100" 
      xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"
    >
      <circle cx="12" cy="12" r="4"></circle>
      <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"></path>
    </svg>
    
    <svg 
      class="absolute h-4 w-4 transition-all duration-500 ease-out transform
             dark:rotate-0 dark:scale-100 dark:opacity-100
             -rotate-90 scale-0 opacity-0" 
      xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"
    >
      <path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"></path>
    </svg>
  </div>
</button>

<script is:inline>
  function initThemeToggle() {
    const toggleBtn = document.getElementById('astro-theme-toggle');
    if (!toggleBtn) return;

    toggleBtn.removeEventListener('click', handleToggleClick);
    toggleBtn.addEventListener('click', handleToggleClick);
  }

  function handleToggleClick(event) {
    const isDark = document.documentElement.classList.contains('dark');

    // Базовая функция переключения темы
    const changeTheme = () => {
      if (isDark) {
        document.documentElement.classList.remove('dark');
        localStorage.setItem('theme', 'light');
      } else {
        document.documentElement.classList.add('dark');
        localStorage.setItem('theme', 'dark');
      }
    };

    // Если браузер старый и не поддерживает View Transition, просто меняем тему
    if (!document.startViewTransition) {
      changeTheme();
      return;
    }

    // Получаем координаты центра клика по кнопке
    const x = event.clientX;
    const y = event.clientY;

    // Считаем расстояние до самого дальнего угла экрана, чтобы круг перекрыл всё
    const endRadius = Math.hypot(
      Math.max(x, window.innerWidth - x),
      Math.max(y, window.innerHeight - y)
    );

    // Запускаем нативную анимацию переключения
    const transition = document.startViewTransition(() => {
      changeTheme();
    });

    // Когда новое состояние готово, запускаем CSS-анимацию круга (clip-path)
    transition.ready.then(() => {
      const clipPath = [
        `circle(0px at ${x}px ${y}px)`,
        `circle(${endRadius}px at ${x}px ${cy = y}px)`
      ];

      document.documentElement.animate(
        {
          clipPath: clipPath,
        },
        {
          duration: 450,
          easing: 'ease-in-out',
          // Анимируем именно псевдоэлемент новой страницы
          pseudoElement: '::view-transition-new(root)',
        }
      );
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initThemeToggle);
  } else {
    initThemeToggle();
  }

  document.addEventListener('astro:page-load', initThemeToggle);
</script>

<style is:global>
  /* Отключаем стандартный встроенный эффект перекрестного затухания (Fade), 
     чтобы он не мешал нашему кругу */
  ::view-transition-old(root),
  ::view-transition-new(root) {
    animation: none;
    mix-blend-mode: normal;
  }

  /* Старая страница остается снизу */
  ::view-transition-old(root) {
    z-index: 1;
  }

  /* Новая страница накладывается сверху через наш круговой clip-path */
  ::view-transition-new(root) {
    z-index: 9999;
  }
</style>