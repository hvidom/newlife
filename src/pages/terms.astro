---
import Layout from "@/layouts/Layout.astro";
---

<Layout title="Terms & Conditions" description="Terms & Conditions of New Life Integration & Wellbeing Network CLG.">
	
	<section class="bg-gradient-to-b from-teal-950/40 via-background to-background pt-20 pb-12 text-center relative border-b border-border/40">
		<div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 relative z-10">
			<h1 class="text-4xl sm:text-5xl font-extrabold tracking-tight text-foreground mb-4">Terms & Conditions</h1>
			<p class="text-muted-foreground text-sm max-w-xl mx-auto leading-relaxed">
				Standard terms of service for utilizing NLI's websites, programs, and branch assets.
			</p>
		</div>
	</section>

	<section class="py-16">
		<div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8 text-sm sm:text-base leading-relaxed text-muted-foreground space-y-6">
			<h2 class="text-xl font-bold text-foreground mt-4">1. Acceptance of Terms</h2>
			<p>
				By accessing this website, registering for NLI events, or utilizing our downloadable templates, you agree to comply with and be bound by these terms.
			</p>

			<h2 class="text-xl font-bold text-foreground mt-4">2. Non-Commercial Use</h2>
			<p>
				All brand assets, methodology models, and grant proposal templates supplied by New Life Integration are reserved strictly for non-profit, community integration support. Commercial use or replication for commercial gain is strictly prohibited.
			</p>
		</div>
	</section>

</Layout>
