---
import HeroHeader from "@/components/HeroHeader.astro";
import { Button } from "@/components/ui/button";
import Layout from "@/layouts/Layout.astro";

const steps = [
  {
    number: "01",
    title: "Identify Potential Funding",
    desc: "Researching local government funds, national community grants, and integration initiatives in Ireland (like the Community Integration Fund).",
  },
  {
    number: "02",
    title: "Design Your Integration Project",
    desc: "Outlining exact goals, event calendars, target families/participants, and key success indicators (social impact, wellbeing, networking).",
  },
  {
    number: "03",
    title: "Establish Transparent Budgets",
    desc: "Drafting accurate budget estimates. Showing exactly how funding will cover venues, workshops, professional facilitators, and community refreshments.",
  },
  {
    number: "04",
    title: "Structure Your Application",
    desc: "Writing a clear, compelling story about your local community needs. Submitting the application using NLI's pre-approved non-profit templates.",
  },
];
---

<Layout title="New Life Integration & Wellbeing Network CLG - Grant Services" description="Access free community grant writing support and integration funding aids with New Life Integration & Wellbeing Network CLG.">
	
	<!-- Header -->

	<HeroHeader 
	title="Grant Services" 
	description="Access free resources, proven proposal templates, and expert grant writing aids to secure funding for local integration events." 
	badge="Funding Support"
	/>

	<!-- Grant Program Detail -->
	<section class="py-16">
		<div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8">
			<div class="grid grid-cols-1 md:grid-cols-2 gap-10 items-center">
				<div class="space-y-4">
					<h2 class="text-2xl font-extrabold text-foreground">Why We Provide Grant Aid</h2>
					<p class="text-muted-foreground text-sm leading-relaxed">
						Funding is the fuel that powers community programs. Whether it's buying study materials for integration workshops, booking spaces for wellbeing circles, or securing local transport for families—it all requires financial support.
					</p>
					<p class="text-muted-foreground text-sm leading-relaxed">
						Writing successful grant applications is a complex task. Our team of experienced community writers provides free consultation, editing services, and templates to maximize your success.
					</p>
				</div>
				<div class="bg-muted/30 border border-border/40 p-6 rounded-3xl space-y-4">
					<div class="text-xs font-bold text-primary uppercase tracking-widest">Support Guidelines</div>
					<ul class="space-y-3 text-xs text-muted-foreground">
						<li class="flex items-center gap-2"><span>📂</span> <strong>Available Resources:</strong> Template applications & checklists</li>
						<li class="flex items-center gap-2"><span>💶</span> <strong>Services Cost:</strong> 100% Free for branch applications</li>
						<li class="flex items-center gap-2"><span>📈</span> <strong>Success Rates:</strong> Built on industry-proven templates</li>
						<li class="flex items-center gap-2"><span>🛡️</span> <strong>Governance:</strong> Fully transparent, compliant models</li>
					</ul>
				</div>
			</div>
		</div>
	</section>

	<!-- Steps -->
	<section class="py-16 bg-muted/20 border-t border-b border-border/40">
		<div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
			<div class="text-center mb-12">
				<span class="text-xs font-extrabold uppercase tracking-widest text-primary">Proven Process</span>
				<h2 class="text-3xl font-extrabold tracking-tight mt-2 text-foreground">Community Grant Pathway</h2>
				<p class="text-muted-foreground text-xs sm:text-sm mt-2">Follow these four key steps to secure community integration resources.</p>
			</div>

			<div class="grid grid-cols-1 md:grid-cols-4 gap-6">
				{steps.map(step => (
					<div class="bg-card p-6 rounded-3xl border border-border/40 shadow-sm relative flex flex-col justify-between hover:shadow-md transition-all">
						<div>
							<span class="text-2xl font-black text-primary/30 block mb-4">{step.number}</span>
							<h3 class="font-extrabold text-sm text-foreground mb-2 leading-tight">{step.title}</h3>
						</div>
						<p class="text-muted-foreground text-xs leading-relaxed mt-2">{step.desc}</p>
					</div>
				))}
			</div>
		</div>
	</section>

	<!-- Contact CTA -->
	<section class="py-16 text-center">
		<div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8">
			<h2 class="text-2xl sm:text-3xl font-extrabold text-foreground">Need Funding for Your Project?</h2>
			<p class="text-muted-foreground text-xs sm:text-sm mt-3 mb-8 leading-relaxed max-w-xl mx-auto">
				Reach out to our grant writing team today. We'll help you review your project ideas and connect you with matching templates.
			</p>
			<a href="/contact">
				<Button size="lg" className="rounded-full font-bold px-8">
					Contact Grant Writers
				</Button>
			</a>
		</div>
	</section>

</Layout>
