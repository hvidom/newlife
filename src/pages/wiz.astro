---
import { Button } from "@/components/ui/button";
import Layout from "@/layouts/Layout.astro";

const workshops = [
  {
    title: "High-Performance Habits",
    desc: "Establishing foundational daily structures, routines, and workflows that boost productivity and mental focus while reducing daily anxiety.",
  },
  {
    title: "Action-Oriented Goal Setting",
    desc: "Learning how to define realistic, measurable, and highly motivational personal and professional integration targets.",
  },
  {
    title: "Integration Resilience",
    desc: "Adapting to new cultures and systems while maintaining deep mental wellbeing, self-efficacy, and a positive mindset.",
  },
];
---

<Layout title="Wiz at Life" description="Experience Wiz at Life evening workshops focusing on motivation, personal development, goal-setting, and wellbeing in Ireland.">
	
	<!-- Header -->
	<section class="bg-gradient-to-b from-teal-950/40 via-background to-background pt-20 pb-12 text-center relative border-b border-border/40">
		<div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 relative z-10">
			<span class="text-xs font-extrabold uppercase tracking-widest text-primary">Motivation & Habits</span>
			<h1 class="text-4xl sm:text-5xl font-extrabold tracking-tight text-foreground mt-2 mb-4">Wiz at Life</h1>
			<p class="text-muted-foreground text-base max-w-2xl mx-auto leading-relaxed">
				Transformative personal development workshops and motivational evenings designed to help you establish powerful daily habits and succeed in Ireland.
			</p>
		</div>
	</section>

	<!-- Details -->
	<section class="py-16">
		<div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8">
			<div class="grid grid-cols-1 md:grid-cols-2 gap-10 items-center">
				<div class="space-y-4">
					<h2 class="text-2xl font-extrabold text-foreground">What is Wiz at Life?</h2>
					<p class="text-muted-foreground text-sm leading-relaxed">
						<strong>Wiz at Life</strong> is a specialized personal empowerment program delivered in partnership with local branches. We believe that successful integration is deeply rooted in personal growth, high-energy motivation, and high-performance habits.
					</p>
					<p class="text-muted-foreground text-sm leading-relaxed">
						Our evening workshops are led by professional coaches and integration trainers. They combine interactive exercises, focus sessions, and community networking circles in a highly encouraging environment.
					</p>
				</div>
				<div class="bg-muted/30 border border-border/40 p-6 rounded-3xl space-y-4">
					<div class="text-xs font-bold text-primary uppercase tracking-widest">Session Highlights</div>
					<ul class="space-y-3 text-xs text-muted-foreground">
						<li class="flex items-center gap-2"><span>🎯</span> <strong>Focus Area:</strong> Productivity & High-Performance Habits</li>
						<li class="flex items-center gap-2"><span>🎟️</span> <strong>Ticket Price:</strong> €35 (Free vouchers available for volunteers)</li>
						<li class="flex items-center gap-2"><span>☕</span> <strong>Includes:</strong> Seminar guides, worksheets, and refreshments</li>
						<li class="flex items-center gap-2"><span>✨</span> <strong>Aesthetic:</strong> Interactive, engaging, and supportive</li>
					</ul>
				</div>
			</div>
		</div>
	</section>

	<!-- Workshop Grid -->
	<section class="py-16 bg-muted/20 border-t border-b border-border/40">
		<div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
			<div class="text-center mb-12">
				<span class="text-xs font-extrabold uppercase tracking-widest text-primary">Curriculum</span>
				<h2 class="text-3xl font-extrabold tracking-tight mt-2 text-foreground">Key Pillars</h2>
				<p class="text-muted-foreground text-xs sm:text-sm mt-2">What you will master during our evening motivation programs.</p>
			</div>

			<div class="grid grid-cols-1 md:grid-cols-3 gap-6">
				{workshops.map(work => (
					<div class="bg-card p-6 rounded-3xl border border-border/40 shadow-sm hover:shadow-md transition-all text-center">
						<span class="text-3xl mb-3 block">⚡</span>
						<h3 class="font-extrabold text-sm text-foreground mb-2">{work.title}</h3>
						<p class="text-muted-foreground text-xs leading-relaxed">{work.desc}</p>
					</div>
				))}
			</div>
		</div>
	</section>

	<!-- CTA -->
	<section class="py-16 text-center">
		<div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8">
			<h2 class="text-2xl sm:text-3xl font-extrabold text-foreground">Ignite Your Potential</h2>
			<p class="text-muted-foreground text-xs sm:text-sm mt-3 mb-8 leading-relaxed max-w-xl mx-auto">
				Check our events page to find when the next "Wiz at Life" evening is scheduled for your county, or register interest to request one in your local branch.
			</p>
			<div class="flex justify-center gap-4">
				<a href="/events">
					<Button className="rounded-full font-bold px-6">Explore Upcoming Dates</Button>
				</a>
				<a href="/contact">
					<Button variant="outline" className="rounded-full font-bold px-6">Request in My Area</Button>
				</a>
			</div>
		</div>
	</section>

</Layout>
