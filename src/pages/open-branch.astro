---
import { BranchForm } from "@/components/forms/branch-form";
import Layout from "@/layouts/Layout.astro";

const features = [
  {
    title: "Full Methodology",
    desc: "Access proven frameworks, event structures, and community integration blueprints from day one.",
    emoji: "📖",
  },
  {
    title: "Brand Identity",
    desc: "Receive pre-made logo suites, document headers, and county-specific marketing templates.",
    emoji: "🎨",
  },
  {
    title: "Training",
    desc: "Free registration for modules of our hybrid Leadership Foundations certification program.",
    emoji: "🎓",
  },
  {
    title: "Grant Writing Templates",
    desc: "Pre-approved proposals and budget sheets to apply for county-level and national community integration funds.",
    emoji: "💶",
  },
];
---

<Layout title="New Life Integration & Wellbeing Network CLG - Open a Branch" description="Lead integration efforts in your town. Learn about New Life Integration branch guidelines and submit your expression of interest.">
	
	<!-- Header -->
	<section class="bg-linear-to-b from-teal-950/40 via-background to-background pt-20 pb-12 text-center relative border-b border-border/40">
		<div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 relative z-10">
			<span class="text-xs font-extrabold uppercase tracking-widest text-primary font-sans">Lead Your Community</span>
			<h1 class="text-4xl sm:text-5xl font-extrabold tracking-tight text-foreground mt-2 mb-4">Open a Branch</h1>
			<p class="text-muted-foreground text-base max-w-2xl mx-auto leading-relaxed">
				Establish volunteer-led integration systems in your city with NLI's training, brand assets, and grant resources.
			</p>
		</div>
	</section>

	<!-- Important Warning Alert: Not a Franchise -->
	<section class="py-6">
		<div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8">
			<div class="bg-amber-500/10 border border-amber-500/20 text-amber-900 dark:text-amber-300 p-6 rounded-3xl flex items-start gap-4">
				<span class="text-2xl mt-0.5">⚠️</span>
				<div>
					<h3 class="font-extrabold text-sm mb-1">Not a Commercial Franchise</h3>
					<p class="text-xs leading-relaxed opacity-90">
						NLI branches are part of a non-profit, volunteer-led community network. There are absolutely <strong>no setup fees, no franchise royalties, and no commercial expectations</strong>. We build cooperative hubs to support families, not to generate commercial profit.
					</p>
				</div>
			</div>
		</div>
	</section>

	<!-- What We Provide -->
	<section class="py-12 bg-muted/20 border-t border-b border-border/40">
		<div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
			<div class="text-center mb-12">
				<span class="text-xs font-extrabold uppercase tracking-widest text-primary font-sans">NLI Support</span>
				<h2 class="text-3xl font-extrabold tracking-tight mt-2 text-foreground">What We Provide</h2>
				<p class="text-muted-foreground text-xs sm:text-sm mt-2">Everything you need to successfully launch and manage a local branch.</p>
			</div>

			<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
				{features.map(feat => (
					<div class="bg-card p-6 rounded-3xl border border-border/40 shadow-sm hover:shadow-md transition-all text-center">
						<span class="text-3xl mb-3 block">{feat.emoji}</span>
						<h3 class="font-extrabold text-sm text-foreground mb-2 leading-tight">{feat.title}</h3>
						<p class="text-muted-foreground text-xs leading-relaxed">{feat.desc}</p>
					</div>
				))}
			</div>
		</div>
	</section>

	<!-- Expression of Interest Form -->
	<section class="py-16">
		<div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8">
			<div class="text-center mb-10">
				<span class="text-xs font-extrabold uppercase tracking-widest text-primary">Expression of Interest</span>
				<h2 class="text-3xl font-extrabold tracking-tight mt-2 text-foreground">Branch Application</h2>
				<p class="text-muted-foreground text-xs mt-2">Complete the questionnaire below. Our national coordinator will contact you within 2–3 business days.</p>
			</div>

			<BranchForm client:load />
		</div>
	</section>

</Layout>
