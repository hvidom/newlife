---
import Layout from "@/layouts/Layout.astro";
import { Button } from "@/components/ui/button";
---

<Layout title="Page Not Found | Newlife" description="Oops! The page you are looking for does not exist. Let us help you find your way back.">
  <div class="relative flex flex-1 items-center justify-center py-12 md:py-20 overflow-hidden">
    
    <div class="absolute inset-0 flex items-center justify-center opacity-30 pointer-events-none">
      <div class="absolute h-[350px] w-[350px] md:h-[500px] md:w-[500px] rounded-full bg-primary/10 blur-3xl animate-pulse"></div>
      <div class="absolute h-[200px] w-[200px] rounded-full bg-teal-500/5 blur-2xl translate-x-20 -translate-y-10"></div>
    </div>

    <div class="relative mx-auto flex max-w-md flex-col items-center text-center px-4 z-10">
      
      <div class="mb-6 flex h-24 w-24 md:h-28 md:w-28 animate-bounce items-center justify-center rounded-2xl bg-muted/40 border border-border/60 shadow-xl backdrop-blur-sm animation-duration-[3s]">
        <svg 
          xmlns="http://www.w3.org/2000/svg" 
          width="48" 
          height="48" 
          viewBox="0 0 24 24" 
          fill="none" 
          stroke="currentColor" 
          stroke-width="1.5" 
          stroke-linecap="round" 
          stroke-linejoin="round" 
          class="text-primary animate-spin animation-duration-[20s]"
        >
          <circle cx="12" cy="12" r="10"/>
          <polygon points="16.24 7.76 14.12 14.12 7.76 16.24 9.88 9.88 16.24 7.76"/>
        </svg>
      </div>

      <h1 class="text-7xl font-extrabold tracking-tight md:text-8xl select-none bg-linear-to-b from-foreground to-muted-foreground/60 bg-clip-text text-transparent">
        404
      </h1>

      <h2 class="mt-4 text-xl font-bold tracking-tight text-foreground md:text-2xl">
        Page Not Found
      </h2>
      
      <p class="mt-3 text-sm md:text-base text-muted-foreground leading-relaxed">
        Oops! It seems we can't find the page you're looking for. Perhaps it's off exploring new opportunities or has integrated somewhere else.
      </p>

      <div class="mt-8 flex w-full flex-col sm:flex-row items-center justify-center gap-3">
        <a href="/" class="w-full sm:w-auto">
          <Button variant="default" className="w-full sm:w-auto h-11 px-6 rounded-full font-medium shadow-md shadow-primary/10 hover:shadow-lg transition-all duration-200">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="mr-2 h-4 w-4"><path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
            Return to Homepage
          </Button>
        </a>
        
        <a href="/contact" class="w-full sm:w-auto">
          <Button variant="outline" className="w-full sm:w-auto h-11 px-6 rounded-full font-medium bg-background/50 hover:bg-muted border-border/60 transition-colors">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="mr-2 h-4 w-4"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
            Contact Support
          </Button>
        </a>
      </div>

    </div>
  </div>
</Layout>