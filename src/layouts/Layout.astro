---

import { ClientRouter } from "astro:transitions";
import Analytic from "@/components/layouts/analytic.astro";
import BaseHead from "@/components/layouts/base-head.astro";
import Footer from "@/components/layouts/footer.astro";
import Header from "@/components/layouts/header.astro";
import Preloader from "@/components/layouts/Preloader.astro";
import ScrollToTop from "@/components/layouts/ScrollToTop.astro";
import TailwindIndicator from "@/components/layouts/tailwind-indicator.astro";
import { cn } from "@/lib/utils";

type Props = {
  title: string;
  description?: string;
  mainClass?: string;
};

const { title, description, mainClass } = Astro.props;
Astro.response.headers.set(
  "Cache-Control",
  "public, max-age=0, s-maxage=31536000, must-revalidate",
);
---

<html lang="en" class="scroll-smooth" data-astro-transition-persist="theme">
	<head>
		<BaseHead title={title} description={description} />
		<ClientRouter />
	</head>
	<body
		class="min-h-screen flex flex-col bg-background text-foreground relative overflow-x-hidden"
	>
		<Analytic />
		<Preloader />
		<TailwindIndicator />
		<Header />
		<div class="relative z-10 flex-1 flex flex-col">
			<main class={cn("flex-1", mainClass)}>
				<slot />
				<ScrollToTop />
			</main>
		</div>
		<Footer />
	</body>
</html>