---

import { ClientRouter } from "astro:transitions";
import BaseHead from "@/components/layouts/blog-head.astro";
import Footer from "@/components/layouts/footer.astro";
import Header from "@/components/layouts/header.astro";
import TailwindIndicator from "@/components/layouts/tailwind-indicator.astro";
import { cn } from "@/lib/utils";

interface Props {
  title: string;
  description?: string;
  image?: string;
  mainClass?: string;
  type?: "website" | "article"; // Добавили тип: article для блогов, website для обычных страниц
  publishDate?: string; // Для вывода даты публикации статьи в блоге
  author?: string; // Для указания автора статьи
}

const {
  title,
  description,
  image,
  mainClass,
  type = "article",
  publishDate,
  author = "Newlife Team",
} = Astro.props;
---

<html lang="en" class="scroll-smooth" data-astro-transition-persist="theme">
	<head>
		<BaseHead 
            title={title} 
            description={description} 
            image={image}
            type={type}
            publishDate= {publishDate}
            author={author}
        />
		<ClientRouter />
	</head>
	<body
		class="min-h-screen flex flex-col bg-background text-foreground relative overflow-x-hidden"
	>
		<TailwindIndicator />
		
		<Header />

		<div class="relative z-10 flex-1 flex flex-col">
			<main class={cn("flex-1", mainClass)}>
				<slot />
			</main>
		</div>

		<Footer />
	</body>
</html>